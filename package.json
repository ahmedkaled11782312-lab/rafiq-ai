{
  "name": "rafiq-ai",
  "private": true,
  "version": "0.1.0",
  "description": "منصة رفيق المعلم التعليمية",
  "workspaces": ["apps/web", "apps/api"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "build": "npm --workspace apps/web run build",
    "start": "npm --workspace apps/api run start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
