import 'dotenv/config'
import express from 'express'
import cors from 'cors'
import helmet from 'helmet'
import pg from 'pg'
import bcrypt from 'bcryptjs'
import jwt from 'jsonwebtoken'

const app = express()
const port = Number(process.env.PORT || 4000)
const jwtSecret = process.env.JWT_SECRET || 'dev-secret-change-me-rafiq-ai'
const inMemoryUsers = []
const inMemoryCourses = []

app.disable('x-powered-by')
app.use(helmet())
app.use(cors({ origin: process.env.CLIENT_ORIGIN || 'http://localhost:5173', credentials: true }))
app.use(express.json({ limit: '2mb' }))

const pool = process.env.DATABASE_URL
  ? new pg.Pool({
      connectionString: process.env.DATABASE_URL,
      ssl: process.env.DATABASE_URL.includes('localhost') ? false : { rejectUnauthorized: false },
    })
  : null

const signToken = (user) =>
  jwt.sign(
    { sub: user.id, email: user.email, name: user.name, role: user.role },
    jwtSecret,
    { expiresIn: '7d' },
  )

const authRequired = (req, res, next) => {
  const header = req.headers.authorization || ''
  const token = header.startsWith('Bearer ') ? header.slice(7) : ''

  if (!token) {
    return res.status(401).json({ error: 'UNAUTHORIZED', message: 'يجب تسجيل الدخول أولاً.' })
  }

  try {
    const payload = jwt.verify(token, jwtSecret)
    req.user = payload
    return next()
  } catch {
    return res.status(401).json({ error: 'UNAUTHORIZED', message: 'رمز الدخول غير صالح.' })
  }
}

const normalizeUser = (user) => ({
  id: user.id || user.user_id,
  email: user.email,
  name: user.display_name || user.name,
  role: user.role || 'student',
})

const normalizeCourse = (course) => ({
  id: course.id,
  title: course.title,
  teacher: course.teacher || 'المعلم',
  level: course.level || 'الثانوية',
  color: course.color || 'violet',
  progress: Number(course.progress || 0),
  lessons: Number(course.lessons || 0),
})

const addLocalCourse = (userId, payload) => {
  const course = {
    id: `local-${Date.now()}`,
    user_id: userId,
    title: payload.title,
    teacher: payload.teacher || 'المعلم',
    level: payload.level || 'الثانوية',
    color: payload.color || 'violet',
    progress: Number(payload.progress || 0),
    lessons: Number(payload.lessons || 0),
  }
  inMemoryCourses.push(course)
  return normalizeCourse(course)
}

app.get('/api/health', async (_req, res) => {
  let database = 'not_configured'
  if (pool) {
    try {
      await pool.query('SELECT 1')
      database = 'connected'
    } catch {
      database = 'unavailable'
    }
  }

  res.status(database === 'unavailable' ? 503 : 200).json({
    status: database === 'unavailable' ? 'degraded' : 'ok',
    database,
    service: 'rafiq-ai-api',
    timestamp: new Date().toISOString(),
  })
})

app.post('/api/auth/register', async (req, res) => {
  const { name, email, password } = req.body || {}

  if (!name || !email || !password) {
    return res.status(400).json({ error: 'INVALID_INPUT', message: 'الاسم والبريد وكلمة المرور مطلوبة.' })
  }

  if (password.length < 8) {
    return res.status(400).json({ error: 'INVALID_INPUT', message: 'يجب أن تكون كلمة المرور 8 أحرف على الأقل.' })
  }

  try {
    if (pool) {
      const existing = await pool.query('SELECT id FROM users WHERE email = $1', [String(email).trim().toLowerCase()])
      if (existing.rowCount > 0) {
        return res.status(409).json({ error: 'EMAIL_EXISTS', message: 'هذا البريد مسجل بالفعل.' })
      }

      const passwordHash = await bcrypt.hash(String(password), 10)
      const result = await pool.query(
        `INSERT INTO users (email, password_hash, display_name, role)
         VALUES ($1, $2, $3, 'student')
         RETURNING id, email, display_name AS name, role`,
        [String(email).trim().toLowerCase(), passwordHash, String(name).trim()],
      )

      const user = normalizeUser(result.rows[0])
      const token = signToken(user)
      return res.status(201).json({ token, user })
    }

    const existing = inMemoryUsers.find((entry) => entry.email === String(email).trim().toLowerCase())
    if (existing) {
      return res.status(409).json({ error: 'EMAIL_EXISTS', message: 'هذا البريد مسجل بالفعل.' })
    }

    const passwordHash = await bcrypt.hash(String(password), 10)
    const newUser = {
      id: `local-${Date.now()}`,
      email: String(email).trim().toLowerCase(),
      name: String(name).trim(),
      passwordHash,
      role: 'student',
    }
    inMemoryUsers.push(newUser)

    const user = normalizeUser(newUser)
    const token = signToken(user)
    return res.status(201).json({ token, user })
  } catch (error) {
    console.error('Register error:', error)
    return res.status(500).json({ error: 'SERVER_ERROR', message: 'حدث خطأ أثناء إنشاء الحساب.' })
  }
})

app.post('/api/auth/login', async (req, res) => {
  const { email, password } = req.body || {}

  if (!email || !password) {
    return res.status(400).json({ error: 'INVALID_INPUT', message: 'البريد وكلمة المرور مطلوبة.' })
  }

  try {
    if (pool) {
      const result = await pool.query(
        'SELECT id, email, display_name AS name, password_hash, role FROM users WHERE email = $1',
        [String(email).trim().toLowerCase()],
      )

      if (result.rowCount === 0) {
        return res.status(401).json({ error: 'INVALID_CREDENTIALS', message: 'بيانات الدخول غير صحيحة.' })
      }

      const userRow = result.rows[0]
      const valid = await bcrypt.compare(String(password), userRow.password_hash)
      if (!valid) {
        return res.status(401).json({ error: 'INVALID_CREDENTIALS', message: 'بيانات الدخول غير صحيحة.' })
      }

      const user = normalizeUser(userRow)
      const token = signToken(user)
      return res.status(200).json({ token, user })
    }

    const user = inMemoryUsers.find((entry) => entry.email === String(email).trim().toLowerCase())
    if (!user) {
      return res.status(401).json({ error: 'INVALID_CREDENTIALS', message: 'بيانات الدخول غير صحيحة.' })
    }

    const valid = await bcrypt.compare(String(password), user.passwordHash)
    if (!valid) {
      return res.status(401).json({ error: 'INVALID_CREDENTIALS', message: 'بيانات الدخول غير صحيحة.' })
    }

    const publicUser = normalizeUser(user)
    return res.status(200).json({ token: signToken(publicUser), user: publicUser })
  } catch (error) {
    console.error('Login error:', error)
    return res.status(500).json({ error: 'SERVER_ERROR', message: 'حدث خطأ أثناء تسجيل الدخول.' })
  }
})

app.get('/api/courses', authRequired, async (req, res) => {
  try {
    if (pool) {
      const result = await pool.query(
        `SELECT id, title, COALESCE(description, '') AS description, user_id, color, "created_at"
         FROM courses WHERE user_id = $1 ORDER BY created_at DESC LIMIT 50`,
        [req.user.sub],
      )

      return res.status(200).json({ items: result.rows.map((entry) => ({
        id: entry.id,
        title: entry.title,
        teacher: 'المعلم',
        level: 'الثانوية',
        color: entry.color || 'violet',
        progress: 0,
        lessons: 0,
      })) })
    }

    const userCourses = inMemoryCourses.filter((course) => course.user_id === req.user.sub)
    return res.status(200).json({ items: userCourses.map((course) => normalizeCourse(course)) })
  } catch (error) {
    console.error('Get courses error:', error)
    return res.status(500).json({ error: 'SERVER_ERROR', message: 'تعذر جلب المواد.' })
  }
})

app.post('/api/courses', authRequired, async (req, res) => {
  const { title, teacher, level, color, progress, lessons } = req.body || {}

  if (!title || !String(title).trim()) {
    return res.status(400).json({ error: 'INVALID_INPUT', message: 'اسم المادة مطلوب.' })
  }

  try {
    if (pool) {
      const result = await pool.query(
        `INSERT INTO courses (user_id, title, description, color)
         VALUES ($1, $2, $3, $4)
         RETURNING id, title, color`,
        [req.user.sub, String(title).trim(), String(teacher || 'المعلم'), color || 'violet'],
      )

      return res.status(201).json({
        item: {
          id: result.rows[0].id,
          title: result.rows[0].title,
          teacher: teacher || 'المعلم',
          level: level || 'الثانوية',
          color: result.rows[0].color || 'violet',
          progress: Number(progress || 0),
          lessons: Number(lessons || 0),
        },
      })
    }

    const item = addLocalCourse(req.user.sub, { title, teacher, level, color, progress, lessons })
    return res.status(201).json({ item })
  } catch (error) {
    console.error('Create course error:', error)
    return res.status(500).json({ error: 'SERVER_ERROR', message: 'تعذر إنشاء المادة.' })
  }
})

app.put('/api/courses/:id', authRequired, async (req, res) => {
  const { title, teacher, level, color, progress, lessons } = req.body || {}
  const { id } = req.params

  try {
    if (pool) {
      const result = await pool.query(
        `UPDATE courses
         SET title = COALESCE($1, title), description = COALESCE($2, description), color = COALESCE($3, color), updated_at = now()
         WHERE id = $4 AND user_id = $5
         RETURNING id, title, description, color`,
        [title ? String(title).trim() : null, teacher ? String(teacher).trim() : null, color || null, id, req.user.sub],
      )

      if (result.rowCount === 0) {
        return res.status(404).json({ error: 'NOT_FOUND', message: 'المادة غير موجودة.' })
      }

      return res.status(200).json({ item: normalizeCourse({ ...result.rows[0], progress, lessons, teacher, level }) })
    }

    const index = inMemoryCourses.findIndex((course) => course.id === id && course.user_id === req.user.sub)
    if (index === -1) {
      return res.status(404).json({ error: 'NOT_FOUND', message: 'المادة غير موجودة.' })
    }

    inMemoryCourses[index] = {
      ...inMemoryCourses[index],
      title: title || inMemoryCourses[index].title,
      teacher: teacher || inMemoryCourses[index].teacher,
      level: level || inMemoryCourses[index].level,
      color: color || inMemoryCourses[index].color,
      progress: Number(progress ?? inMemoryCourses[index].progress),
      lessons: Number(lessons ?? inMemoryCourses[index].lessons),
    }

    return res.status(200).json({ item: normalizeCourse(inMemoryCourses[index]) })
  } catch (error) {
    console.error('Update course error:', error)
    return res.status(500).json({ error: 'SERVER_ERROR', message: 'تعذر تحديث المادة.' })
  }
})

app.delete('/api/courses/:id', authRequired, async (req, res) => {
  const { id } = req.params

  try {
    if (pool) {
      const result = await pool.query('DELETE FROM courses WHERE id = $1 AND user_id = $2', [id, req.user.sub])
      if (result.rowCount === 0) {
        return res.status(404).json({ error: 'NOT_FOUND', message: 'المادة غير موجودة.' })
      }
      return res.status(200).json({ success: true })
    }

    const index = inMemoryCourses.findIndex((course) => course.id === id && course.user_id === req.user.sub)
    if (index === -1) {
      return res.status(404).json({ error: 'NOT_FOUND', message: 'المادة غير موجودة.' })
    }

    inMemoryCourses.splice(index, 1)
    return res.status(200).json({ success: true })
  } catch (error) {
    console.error('Delete course error:', error)
    return res.status(500).json({ error: 'SERVER_ERROR', message: 'تعذر حذف المادة.' })
  }
})

app.use((err, _req, res, _next) => {
  console.error('Unhandled API error:', err.message)
  res.status(500).json({ error: 'INTERNAL_ERROR', message: 'حدث خطأ غير متوقع.' })
})

app.listen(port, () => {
  console.log(`Rafiq AI API listening on http://localhost:${port}`)
})
